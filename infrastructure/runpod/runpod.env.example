# Copy these values into the RunPod pod environment. Never commit credentials.
RUNPOD_IMAGE=ghcr.io/OWNER/vocalflux-backend-gpu:main
RUNPOD_GPU_TYPE_ID=NVIDIA GeForce RTX 4090
RUNPOD_CONTAINER_PORT=8000

WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=5

MAX_CONCURRENT_SESSIONS=10
MAX_CONCURRENT_INFERENCES=1
ALLOWED_WEBSOCKET_ORIGINS=https://YOUR_FRONTEND_HOST
CORS_ORIGINS=https://YOUR_FRONTEND_HOST
