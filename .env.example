# Application
APP_ENV=development
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGINS=http://localhost:3000

# Whisper
WHISPER_MODEL=small
# Local default: CPU-first. Use cuda/float16 for GPU demo environments.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=5

# Audio
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# Streaming and VAD
VAD_THRESHOLD=0.5
WINDOW_SIZE_MS=1000
OVERLAP_MS=300
MAX_MESSAGE_SIZE=65536
MAX_AUDIO_BUFFER=300
MAX_QUEUE_SIZE=10
QUEUE_OVERFLOW_POLICY=drop

# Resource limits
MAX_SESSION_DURATION=3600
MAX_CONCURRENT_SESSIONS=10
MAX_CONCURRENT_INFERENCES=1
INFERENCE_TIMEOUT=10
ALLOWED_WEBSOCKET_ORIGINS=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_ATTEMPTS=30
RATE_LIMIT_WINDOW_SECONDS=60
GRACEFUL_SHUTDOWN_TIMEOUT=15

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/v1/transcribe
